# Supabase project (same as frontend)
SUPABASE_URL=https://your-project.supabase.co
# Publishable / anon key — used for GoTrue token refresh endpoint only
SUPABASE_ANON_KEY=your-anon-key
# Service role — server only; never expose to browsers
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# API
PORT=8788
# Comma-separated browser origins allowed for CORS (e.g. http://127.0.0.1:5173)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional: max requests per IP per window for coarse protection
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
